{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dart Frog Backend",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\Pub\\Cache\\bin\\dart_frog.bat",
      "args": ["dev", "--port", "8081"],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "backend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
